#include <fstream.hfa>
#include <stdlib.hfa>									// abs

// user type
struct S { int i, j; };
void ?{}( S & s ) { s.[i, j] = 0; }
void ?{}( S & s, int i, int j ) { s.[i, j] = [i, j]; }
void ?{}( S & s, zero_t ) { s.[i, j] = 0; }
S -?( S s ) with(s) { return (S){ -i, -j }; }
int ?<?( S lhs, S rhs ) with(lhs) { return i < rhs.i || j < rhs.j; }
ofstream & ?|?( ofstream & os, S s ) with(s) { return os | "(" | i | "," | j | ")"; }
OFSTREAM_VOID_IMPL( os, S )								// void version

int main( void ) {
	signed char ch = -65;
	sout | "signed char\t\t"			| ch     | "\t\tabs " | abs( ch );
	sout | "signed int\t\t"				| -65    | "\t\tabs" | abs( -65 );
	sout | "signed long int\t\t" 		| -65l   | "\t\tabs" | abs( -65l );
	sout | "signed long long int\t"		| -65ll  | "\t\tabs" | abs( -65ll );
	sout | "float\t\t\t" 				| -65.0f | "\t\tabs" | abs( -65.0f );
	sout | "double\t\t\t"				| -65.0  | "\t\tabs" | abs( -65.0 );
	sout | "long double\t\t"			| -65.0l | "\t\tabs" | abs( -65.0l );
	sout | "float _Complex\t\t"			| -65.0F-2.0iF | "\tabs" | abs( -65.0F-2.0iF );
	sout | "double _Complex\t\t"		| -65.0D-2.0iD | "\tabs" | abs( -65.0D-2.0iD );
	sout | "long double _Complex\t"		| -65.0L-2.0iL | "\tabs" | abs( -65.0L-2.0iL );
	S s{ -3, -4 };
	sout | "user type\t\t"				| s | "\tabs" | abs( s );
} // main

