// https://en.wikipedia.org/wiki/Decimal_separator, see digit grouping
// Comma cannot be used because of the dreaded comma expression, e.g., 123,345.

int main() {
	// underscore separator

	0b0;												// binary
	0B_1101_0111;
	0b0_0_0_1L;
	0b_000_111_101_lu;
	0b_00_11_10_LLU;

	1;													// decimal
	2_1;
	2_147_483_647;
	37LL;
	45ull;
	89llu;
	99LLu;
	56_lu;
	88_LLu;

	5e +3;
	0;													// octal
	0u;
	0_3_77;
	0_377ul;
	0377_456UL;
	0_123_456_7llU;

	0x1;												// hexadecimal
	0x1u;
	0xabL;
	0x80_00_00_00;
	0x_fff;
	0x_ef3d_aa5c;
	0x_3LL;

	3.;													// integral real
	3_100.;
	1_000_000.;

	3.1;												// integral/fractional real
	3.141_592_654_L;
	123_456.123_456;

	3E1;												// integral/exponent real
	3_e1f;
	3_E1_1_F;
	3_E_11;
	3_e_+11;
	3_E_-11;

	3.0E1;												// integral/fractional/exponent real
	3.0_E1L;
	3.0_e1_1;
	3.0_E_11_l;
	3.0_e_+11l;
	3.0_E_-11;
	123_456.123_456E-16;

	0x_ff.ffp0;											// hex real
	0x_1.ffff_ffff_p_128_l;

	// space separator

	0b0;												// binary
	0B 1101 0111;
	0b0 0 0 1L;
	0b 000 111 101 lu;
	0b 00 11 10 LLU;

	1;													// decimal
	2 1;
	2 147 483 647;
	37LL;
	45ull;
	89llu;
	99LLu;
	56 lu;
	88 LLu;

	0;													// octal
	0u;
	0 3 77;
	0 377ul;
	0377 456UL;
	0 123 456 7llU;

	0x1;												// hexadecimal
	0x1u;
	0xabL;
	0x80 00 00 00;
	0x fff;
	0x ef3d aa5c;
	0x 3LL;

	3.;													// integral real
	3 100.;
	1 000 000.;

	3.1;												// integral/fractional real
	3.141 592 654 L;
	123 456.123 456;

	3E1;												// integral/exponent real
	3 e1f;
	3 E1 1 F;
	3 E 11;
	3 e +11;
	3 E -11;

	3.0E1;												// integral/fractional/exponent real
	3.0 E1L;
	3.0 e1 1;
	3.0 E 11 l;
	3.0 e +11l;
	3.0 E -11;
	123 456.123 456E-16;

	0x ff.ffp0;											// hex real
	0x 1.ffff ffff p 128 l;

	// C23 quote separator, requires -std=c2x/c23

#if __STDC_VERSION__ == 202000L && __GNUC__ >= 12 || __STDC_VERSION__ >= 202311L
	// There is a bug in the gcc preprocessor, where it lexes the program *before* doing conditional compilation.
	// Hence, it lexes 1'000 and generates: warning: missing terminating ' character, even though this token is not
	// included in program due to conditional compilation. Hence, quoted constants must be hidden in a separate file and
	// included only when it is safe to lexically scan them.
	#include "numericConstants.hfa"
#endif

	printf("done\n");
} // main

// Local Variables: //
// tab-width: 4 //
// compile-command: "cfa numericConstants.cfa" //
// End: //
